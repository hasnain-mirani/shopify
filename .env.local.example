# Copy to .env.local and replace placeholders.
# Vercel: use the same variable NAMES on your Next.js project (this repo root deploy).
# Express-only secrets (GEMINI_*, etc.) go on your backend Vercel project — see backend/.env.example

# --------------------------------------------------------------------------- #
#  Shopify Storefront API
# --------------------------------------------------------------------------- #
# Your store's *.myshopify.com domain (not the custom domain).
# Found in: Shopify Admin → Settings → Domains
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Public Storefront API access token (safe to expose to the browser).
# Get it from: Shopify Admin → Settings → Apps and sales channels →
#   Develop apps → Create app → Configuration → Storefront API integration →
#   Install app → copy the "Storefront API access token".
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_public_token

# Storefront API version. Shopify ships a new stable version each quarter.
# See: https://shopify.dev/docs/api/usage/versioning
SHOPIFY_STOREFRONT_API_VERSION=2025-01

# --------------------------------------------------------------------------- #
#  Admin API (required for admin panel)
# --------------------------------------------------------------------------- #
# Same "Develop apps" page, under "Admin API access token".
# Treat like a password — server-only, never prefix with NEXT_PUBLIC_.
SHOPIFY_ADMIN_API_ACCESS_TOKEN=your_admin_private_token

# Admin API version. Should match the version used in admin queries.
SHOPIFY_ADMIN_API_VERSION=2026-04

# --------------------------------------------------------------------------- #
#  Admin Panel Authentication
# --------------------------------------------------------------------------- #
# Password to access the admin panel. Choose a strong password.
ADMIN_PANEL_PASSWORD=your_secure_password_here

# Secret for signing admin session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=your_random_secret_here_min_32_chars

# --------------------------------------------------------------------------- #
#  Cache revalidation
# --------------------------------------------------------------------------- #
# Any random string — used to authenticate Shopify webhooks hitting
# /api/revalidate. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHOPIFY_REVALIDATION_SECRET=your_random_secret_here

# --------------------------------------------------------------------------- #
#  Cloudinary (for image uploads)
# --------------------------------------------------------------------------- #
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_or_signed_preset

# --------------------------------------------------------------------------- #
#  Firebase (web push / client; optional if unused)
# --------------------------------------------------------------------------- #
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_web_push_vapid_key

# --------------------------------------------------------------------------- #
#  SMTP / Order Emails (Gmail recommended)
# --------------------------------------------------------------------------- #
# IMPORTANT for Gmail:
# - SMTP_USER must be your full Gmail address
# - SMTP_PASS must be a Google App Password (not your normal Gmail password)
# - Keep 587 for STARTTLS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password

# Optional: where admin order notifications should be sent (comma-separated for multiple).
ADMIN_ORDER_EMAIL=orders@yourdomain.com

# Brand name shown in order emails (From name + body).
STORE_DISPLAY_NAME=SSHUB

# --------------------------------------------------------------------------- #
#  Public site URL (sitemap, robots, metadata — see src/lib/site-url.ts)
# --------------------------------------------------------------------------- #
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# --------------------------------------------------------------------------- #
#  Postgres (Next server routes use src/lib/db.ts)
# --------------------------------------------------------------------------- #
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres

# --------------------------------------------------------------------------- #
#  API routing — admin catalog + /api/product-ai proxy
# --------------------------------------------------------------------------- #
# NEXT_PUBLIC_API_URL=/api keeps the browser on your Next origin (recommended on Vercel).
# On Vercel set BACKEND_API_URL to your Express deployment, e.g. https://your-backend.vercel.app/api
NEXT_PUBLIC_API_URL=/api
BACKEND_API_URL=http://127.0.0.1:4000/api

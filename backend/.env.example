# Postgres (Supabase pooler or local)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres

# Firebase Configuration (for push notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="your_firebase_private_key"
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# SMTP Configuration (for email notifications)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Server Configuration
PORT=4000
NODE_ENV=development

# CORS — must include your Next.js origin (admin calls this API from the browser)
FRONTEND_URL=http://localhost:3000

# Gemini — admin “generate title & description” (image + Google Search grounding)
# Create a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyBhj0tPxY_Jv_1uHSVnQGgJYpvWjlfMVmE
# Optional: model that supports the Google Search tool (default below)
GEMINI_MODEL=gemini-2.5-flash

# Replicate — optional “Generate professional photo” in admin
# REPLICATE_API_TOKEN=your_replicate_token_here
